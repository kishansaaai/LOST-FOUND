# Copy to .env (make up does this automatically if .env is missing).
POSTGRES_USER=lostfound
POSTGRES_PASSWORD=lostfound_dev
POSTGRES_DB=lostfound
POSTGRES_PORT=5432

# Least-privilege application roles created by migration 0005
APP_RW_PASSWORD=app_rw_dev
APP_RO_PASSWORD=app_ro_dev
ANALYTICS_PASSWORD=analytics_dev

# Runtime connection (backend connects as app_rw, migrations as the owner)
DATABASE_URL=postgresql+psycopg://app_rw:app_rw_dev@localhost:5432/lostfound
MIGRATION_DATABASE_URL=postgresql+psycopg://lostfound:lostfound_dev@localhost:5432/lostfound

MONGO_URL=mongodb://localhost:27017
MONGO_DB=lostfound
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# pg = RRF in a SQL function (DBMS showcase); qdrant = filtered ANN + RRF in a service
MATCH_BACKEND=pg
MATCH_TOP_N=10

JWT_SECRET=change-me-in-real-deployments
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Multiplies every rate limit. Keep 1 in production; set e.g. 20 when running the Playwright e2e suite.
RATE_LIMIT_SCALE=1

# Host ports (change when something else on your machine already uses 8000 or 6379)
API_PORT=8000
REDIS_PORT=6379
